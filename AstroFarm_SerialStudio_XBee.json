 "frameParser": "/**\n * AstroFarm XBee parser\n *\n * Incoming packet format from astrofarm_fixed.py:\n *   0xAF 0xAF + uint16_be(payload_length) + payload_json\n *\n * This project uses start delimiter = AFAF and end delimiter = 0x7D ('}').\n * The frame arrives as binary bytes. We strip the first 2 bytes (length),\n * decode UTF-8 JSON text, parse it, then return numeric values in index order.\n */\nfunction parse(frame) {\n  if (!frame || frame.length < 3)\n    return [];\n\n  // frame[0], frame[1] are payload length bytes (big-endian)\n  let len = (frame[0] << 8) | frame[1];\n  if (len <= 0)\n    return [];\n\n  // Serial Studio may strip the end delimiter (0x7D), so append it if missing.\n  let endIndex = Math.min(frame.length, 2 + len);\n  let payloadBytes = frame.slice(2, endIndex);\n  if (payloadBytes.length === 0)\n    return [];\n\n  if (payloadBytes[payloadBytes.length - 1] !== 0x7D)\n    payloadBytes.push(0x7D);\n\n  let jsonText = '';\n  for (let i = 0; i < payloadBytes.length; ++i)\n    jsonText += String.fromCharCode(payloadBytes[i]);\n\n  let data = JSON.parse(jsonText);\n\n  return [\n    data.temperature,\n    data.humidity,\n    data.co2_ppm,\n    data.co2_sensor_temp,\n    data.par_ue,\n    data.ph,\n    data.tds_ppm,\n    data.ec_ms_cm,\n    data.peltier_pct,\n    data.led_blue_pct,\n    data.led_red_pct,\n    data.servo_angle,\n    data.servo_feeding ? 1 : 0,\n    data.exg_mean,\n    data.green_ratio\n  ];\n}",
